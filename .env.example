# Home Assistant (LLAT - create via Profile > Security > Create token)
# Use the public URL — LAN IP http://10.0.0.12:8123 is NOT reachable from
# inside docker-proxmox containers (HA trusted_networks + binding block it)
HA_BASE_URL=https://example.com
HA_TOKEN=

# Proxmox (Phase 7.4 - create via Datacenter > Permissions > API Tokens)
PVE_BASE_URL=https://10.0.0.10:8006
PVE_TOKEN_ID=homelab-dashboard@pve!readonly
PVE_TOKEN_SECRET=
PVE_INSECURE_TLS=true

# Portainer (Phase 7.5 - create via User settings > Access tokens)
PORTAINER_BASE_URL=https://10.0.0.13:9443
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=2
PORTAINER_INSECURE_TLS=true

CACHE_TTL_SECONDS=15

# Auth (Auth.js v5 + Prisma + SQLite)
# SQLite file path for local dev. In Docker, mounted to /app/data/auth.sqlite
DATABASE_URL=file:./prisma/dev.db
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# First-boot admin bootstrap — creates this user if no admin exists yet
ADMIN_EMAIL=
ADMIN_PASSWORD=

# GitHub auto-sync for the /projects page. When set, the container runs a
# sync every GITHUB_SYNC_INTERVAL_MS (default 60 min) and exposes a "Sync now"
# button in /admin/projects. Token needs `repo` scope for private repos.
GITHUB_TOKEN=
GITHUB_SYNC_OWNER=example-user
GITHUB_SYNC_INTERVAL_MS=3600000
