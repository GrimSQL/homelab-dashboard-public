generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  invitesCreated InviteCode[] @relation("InvitesCreated")
  invitesUsed    InviteCode[] @relation("InvitesUsed")
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  role        String    @default("user")
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?
  revokedAt   DateTime?

  createdBy User  @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InvitesUsed", fields: [usedById], references: [id], onDelete: SetNull)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  group        String
  summary      String    @default("")
  tags         String    @default("[]") // JSON-encoded string array
  date         String    @default("")   // ISO date "YYYY-MM-DD"
  url          String?                   // docs slug (e.g. "app1") — not a full URL
  repoUrl      String?                   // GitHub repo URL
  status       String?                   // "live" | "private" | "doc" | "archived" | null
  markdown     String?                   // full README content
  order        Int       @default(0)
  source       String    @default("manual") // "manual" | "github"
  lastSyncedAt DateTime?                  // last time this row was refreshed from GitHub
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Single-row-ish key/value settings table. Currently used for
// `github.lastSyncAt` (ISO timestamp string).
model AppSetting {
  key   String @id
  value String
}

// Per-attempt login audit log used for in-app rate limiting.
// Entries older than 24h are cleaned up opportunistically.
model LoginAttempt {
  id         String   @id @default(cuid())
  email      String   // lowercased
  ip         String   // best-effort client IP (CF-Connecting-IP / X-Forwarded-For)
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}
