# Portainer API access (used to deploy the stack)
PORTAINER_URL=https://10.0.0.13:9443
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=2

# Runtime environment baked into the stack at deploy time
HA_BASE_URL=http://10.0.0.12:8123
HA_TOKEN=
PVE_BASE_URL=https://10.0.0.10:8006
PVE_TOKEN_ID=homelab-dashboard@pve!readonly
PVE_TOKEN_SECRET=
PORTAINER_BASE_URL=https://10.0.0.13:9443
# The API key the app itself uses at runtime to query Portainer
# (different purpose from PORTAINER_API_KEY above, but can be the same key)
PORTAINER_API_KEY_FOR_STACK=
PORTAINER_ENDPOINT_ID_FOR_STACK=2

# Auth.js session signing secret. Generate with: openssl rand -hex 32
# IMPORTANT: changing this after deploy invalidates all existing sessions.
AUTH_SECRET=

# Public URL the dashboard is served at (used by Auth.js for cookies/redirects)
AUTH_URL=https://homelab.example.com

# Admin bootstrap — first boot creates this user if no admin exists yet.
# After the first boot, this is a NO-OP. To change the admin password later,
# use /admin/users, not this file.
# Password policy: min 12 chars, must contain upper + lower + digit + symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# GitHub token used by the Projects auto-sync (read-only on repos).
# Needs `repo` scope to see private repos. Leave blank to disable auto-sync.
GITHUB_TOKEN=
GITHUB_SYNC_OWNER=example-user
# Interval in ms between automatic syncs (default: 1 hour)
GITHUB_SYNC_INTERVAL_MS=3600000
